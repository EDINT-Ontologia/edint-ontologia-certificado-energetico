# CQ-CERT-01: ¿Cuál es la calificación energética de un edificio?
# Obtiene la letra de calificación para cada certificado

PREFIX edintcee: <https://edint.es/def/certificado-energetico#>

SELECT ?cert ?letter
WHERE {
    ?cert a edintcee:EnergyCertificate ;
          edintcee:hasRating ?rating .
    ?rating edintcee:ratingLetter ?letter .
}
