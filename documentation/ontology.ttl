                                                                       <http://purl.org/dc/terms/title> "EDINT Energy Performance Certificate Ontology for Buildings"@en ,
                                                                                                        "Ontología EDINT de Certificados de Eficiencia Energética de Edificios"@es ;
                                                                       <http://purl.org/vocab/vann/preferredNamespacePrefix> "edintcee" ;
                                                                       <http://purl.org/vocab/vann/preferredNamespaceUri> <https://edint.es/def/certificado-energetico#> ;
                                                                       rdfs:comment "Energy source of the ventilation system according to the energy-source controlled vocabulary."@en ,
                                                                                    "Fuente de energía del sistema de ventilación según el vocabulario controlado de fuentes de energía."@es ,
                                                                                    "Initial (core) version focusing on the main classes: EnergyCertificate, EnergyRating, EnergyLabel, CompetentTechnician, ImprovementRecommendation, CalculationProcedure and UserRecommendations, with their relationships and properties."@en ,
                                                                                    "Versión inicial (core) centrada en las clases principales: EnergyCertificate, EnergyRating, EnergyLabel, CompetentTechnician, ImprovementRecommendation, CalculationProcedure y UserRecommendations, con sus relaciones y propiedades."@es ;
                                                                       rdfs:label "Certificados de Eficiencia Energética"@es ,
