#################################################################
#    Classes
#################################################################

###  http://qudt.org/schema/qudt/QuantityValue
<http://qudt.org/schema/qudt/QuantityValue> rdf:type owl:Class ;
                                            rdfs:comment "Numeric value with explicit unit of measure (qudt:numericValue + qudt:hasUnit). Allows representing physical quantities such as energy (kWh/m²·year), emissions (kgCO2/m²·year), power (kW), area (m²), percentage, etc."@en ,
                                                         "Valor numérico con unidad de medida explícita (qudt:numericValue + qudt:hasUnit). Permite representar magnitudes físicas como energía (kWh/m²·año), emisiones (kgCO2/m²·año), potencia (kW), superficie (m²), porcentaje, etc."@es ;
                                            rdfs:isDefinedBy <http://qudt.org/schema/qudt/> ;
                                            rdfs:label "Quantity value"@en ,
                                                       "Valor de cantidad"@es .


###  http://schema.org/PostalAddress
<http://schema.org/PostalAddress> rdf:type owl:Class ;
                                  rdfs:comment "Dirección postal según schema.org."@es ,
                                               "Postal address according to schema.org."@en ;
                                  rdfs:isDefinedBy <http://schema.org/> ;
                                  rdfs:label "Dirección postal (schema)"@es ,
                                             "Postal address (schema)"@en .


###  http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#Autonomia
<http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#Autonomia> rdf:type owl:Class ;
                                                                                   rdfs:comment "Autonomous Community or Autonomous City in the Spanish territory."@en ,
                                                                                                "Comunidad Autónoma o Ciudad Autónoma del territorio español."@es ;
                                                                                   rdfs:isDefinedBy <http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio> ;
                                                                                   rdfs:label "Autonomous community"@en ,
                                                                                              "Autonomía"@es .


###  http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/direccion-postal#DireccionPostal
<http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/direccion-postal#DireccionPostal> rdf:type owl:Class ;
                                                                                                           rdfs:comment "Dirección postal en España. Especialización de schema:PostalAddress, vcard:Address y locn:Address. Permite representar una dirección con propiedades como schema:streetAddress, schema:addressLocality, schema:addressRegion y schema:postalCode."@es ,
                                                                                                                        "Postal address in Spain. Specialisation of schema:PostalAddress, vcard:Address and locn:Address. Allows representing an address with properties like schema:streetAddress, schema:addressLocality, schema:addressRegion and schema:postalCode."@en ;
                                                                                                           rdfs:isDefinedBy <http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/direccion-postal> ;
                                                                                                           rdfs:label "Dirección postal"@es ,
                                                                                                                      "Postal address"@en .


###  http://www.w3.org/2004/02/skos/core#Concept
<http://www.w3.org/2004/02/skos/core#Concept> rdf:type owl:Class .


###  https://edint.es/def/catastro#CadastralProperty
<https://edint.es/def/catastro#CadastralProperty> rdf:type owl:Class ;
                                                  rdfs:comment "Cadastral unit that identifies a property (parcel, construction or functional unit) in the cadastre. Allows access to the cadastral reference, address, construction year, surface area and geometry."@en ,
                                                               "Unidad catastral que identifica un inmueble (parcela, construcción o unidad funcional) en el catastro. Permite acceder a la referencia catastral, dirección, año de construcción, superficie y geometría."@es ;
                                                  rdfs:isDefinedBy <https://edint.es/def/catastro#> ;
                                                  rdfs:label "Cadastral property"@en ,
                                                             "Inmueble catastral"@es .


###  https://edint.es/def/certificado-energetico#CalculationProcedure
<https://edint.es/def/certificado-energetico#CalculationProcedure> rdf:type owl:Class ;
                                                                   rdfs:comment "Procedimiento reconocido (general o simplificado) inscrito en el Registro general de documentos reconocidos, utilizado para obtener la calificación de eficiencia energética (Art. 4.2.a, Art. 5)."@es ,
                                                                                "Recognised procedure (general or simplified) registered in the general registry of recognised documents, used to obtain the energy performance rating (Art. 4.2.a, Art. 5)."@en ;
                                                                   rdfs:label "Calculation procedure"@en ,
                                                                              "Procedimiento de cálculo"@es .


###  https://edint.es/def/certificado-energetico#CompetentTechnician
<https://edint.es/def/certificado-energetico#CompetentTechnician> rdf:type owl:Class ;
                                                                  rdfs:comment "Technician qualified to carry out energy performance certification of buildings (Art. 4 bis)."@en ,
                                                                               "Técnico habilitado para realizar la certificación de eficiencia energética de edificios (Art. 4 bis)."@es ;
                                                                  rdfs:label "Competent technician"@en ,
