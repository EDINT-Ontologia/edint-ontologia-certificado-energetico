        <rdfs:comment xml:lang="en">Lighting system efficiency. Expressed as qudt:QuantityValue, typically in lm/W.</rdfs:comment>
        <rdfs:label xml:lang="es">eficiencia del sistema de iluminación</rdfs:label>
        <rdfs:label xml:lang="en">lighting system efficiency</rdfs:label>
    </owl:ObjectProperty>
    


