<?xml version="1.0"?>
<rdf:RDF xmlns="https://edint.es/def/certificado-energetico#"
     xml:base="https://edint.es/def/certificado-energetico"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:foaf="http://xmlns.com/foaf/0.1/"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:vocab="https://w3id.org/widoco/vocab#"
     xmlns:schema="http://schema.org/">
    <owl:Ontology rdf:about="https://edint.es/def/certificado-energetico#">
        <owl:versionIRI rdf:resource="https://edint.es/def/certificado-energetico/0.1.1"/>
        <terms:abstract xml:lang="en">Ontology focused on the energy performance certificate as a documentary unit, including energy rating, label, competent technician, improvement recommendations, calculation procedure and user recommendations.</terms:abstract>
        <terms:abstract xml:lang="es">Ontología centrada en el certificado de eficiencia energética como unidad documental, incluyendo calificación energética, etiqueta, técnico competente, recomendaciones de mejora, procedimiento de cálculo y recomendaciones de uso para el usuario.</terms:abstract>
        <terms:bibliographicCitation xml:lang="en">EDINT Energy Performance Certificate Ontology for Buildings. EDINT. Revision: v0.1.1.</terms:bibliographicCitation>
        <terms:bibliographicCitation xml:lang="es">Ontología EDINT de Certificados de Eficiencia Energética de Edificios. EDINT. Revisión: v0.1.1.</terms:bibliographicCitation>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-14</terms:created>
        <terms:creator rdf:nodeID="genid1"/>
        <terms:creator rdf:nodeID="genid2"/>
        <terms:creator rdf:nodeID="genid3"/>
        <terms:creator rdf:nodeID="genid4"/>
        <terms:creator rdf:nodeID="genid5"/>
        <terms:creator rdf:nodeID="genid6"/>
        <terms:description xml:lang="en">An ontology modelling energy performance certificates for buildings according to Spanish Royal Decree 390/2021. The root class is EnergyCertificate; the building is an external entity that points to the certificate via a property defined in its own ontology.</terms:description>
        <terms:description xml:lang="es">Ontología que modela los certificados de eficiencia energética de edificios según el Real Decreto 390/2021. La clase raíz es EnergyCertificate; el edificio es una entidad externa que apunta al certificado mediante una propiedad definida en su propia ontología.</terms:description>
        <terms:hasFormat rdf:resource="https://edint.es/def/certificado-energetico#ontology.ttl"/>
        <terms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-17</terms:issued>
        <terms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-17</terms:modified>
        <terms:publisher rdf:nodeID="genid7"/>
        <terms:source rdf:resource="https://www.boe.es/eli/es/rd/2021/06/01/390"/>
        <terms:title xml:lang="en">EDINT Energy Performance Certificate Ontology for Buildings</terms:title>
        <terms:title xml:lang="es">Ontología EDINT de Certificados de Eficiencia Energética de Edificios</terms:title>
        <vann:preferredNamespacePrefix>edintcee</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri>https://edint.es/def/certificado-energetico#</vann:preferredNamespaceUri>
        <schema:codeRepository rdf:resource="https://github.com/EDINT-Ontologia/edint-ontologia-certificado-energetico"/>
        <schema:creativeWorkStatus xml:lang="en">Ontology Specification</schema:creativeWorkStatus>
        <schema:funding>Espacio de Datos para las Infraestructuras Urbanas Inteligentes (EDINT)</schema:funding>
        <rdfs:comment xml:lang="en">Energy source of the ventilation system according to the energy-source controlled vocabulary.</rdfs:comment>
        <rdfs:comment xml:lang="es">Fuente de energía del sistema de ventilación según el vocabulario controlado de fuentes de energía.</rdfs:comment>
        <rdfs:comment xml:lang="en">Initial (core) version focusing on the main classes: EnergyCertificate, EnergyRating, EnergyLabel, CompetentTechnician, ImprovementRecommendation, CalculationProcedure and UserRecommendations, with their relationships and properties.</rdfs:comment>
        <rdfs:comment xml:lang="es">Versión inicial (core) centrada en las clases principales: EnergyCertificate, EnergyRating, EnergyLabel, CompetentTechnician, ImprovementRecommendation, CalculationProcedure y UserRecommendations, con sus relaciones y propiedades.</rdfs:comment>
        <rdfs:label xml:lang="es">Certificados de Eficiencia Energética</rdfs:label>
        <rdfs:label xml:lang="en">Energy Performance Certificates</rdfs:label>
        <rdfs:label xml:lang="es">fuente energética de ventilación</rdfs:label>
        <rdfs:label xml:lang="en">ventilation energy source</rdfs:label>
        <owl:priorVersion rdf:resource="https://github.com/EDINT-Ontologia/edint-ontologia-certificado-energetico/releases/tag/v0.1.0"/>
        <owl:versionInfo>0.1.1</owl:versionInfo>
        <vocab:jsonldSerialization>ontology.jsonld</vocab:jsonldSerialization>
        <vocab:ntSerialization>ontology.nt</vocab:ntSerialization>
        <vocab:rdfxmlSerialization>ontology.rdf</vocab:rdfxmlSerialization>
        <vocab:turtleSerialization>ontology.ttl</vocab:turtleSerialization>
        <vocab:vocabularyLabel rdf:resource="_:genid2147483656"/>
        <vocab:vocabularyLabel rdf:resource="_:genid2147483657"/>
        <vocab:vocabularyLabel rdf:resource="_:genid2147483658"/>
        <vocab:vocabularyLabel rdf:nodeID="genid8"/>
        <vocab:vocabularyLabel rdf:nodeID="genid9"/>
        <vocab:vocabularyLabel rdf:nodeID="genid10"/>
        <vocab:vocabularyLabel rdf:nodeID="genid11"/>
    </owl:Ontology>
