    </owl:ObjectProperty>
    


    <!-- https://edint.es/def/certificado-energetico#ventilationEnergySource -->


    <owl:ObjectProperty rdf:about="https://edint.es/def/certificado-energetico#ventilationEnergySource">
        <rdfs:domain rdf:resource="https://edint.es/def/certificado-energetico#EnergyCertificate"/>
        <rdfs:range>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#Concept"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
                        <owl:hasValue rdf:resource="https://edint.es/kos/EnergySource"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:range>
    </owl:ObjectProperty>
    


