    <!-- http://www.w3.org/2004/02/skos/core#inScheme -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/2004/02/skos/core#inScheme"/>
    


    <!-- https://edint.es/def/certificado-energetico#certificateType -->


    <owl:ObjectProperty rdf:about="https://edint.es/def/certificado-energetico#certificateType">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://edint.es/def/certificado-energetico#EnergyCertificate"/>
        <rdfs:range>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#Concept"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
                        <owl:hasValue rdf:resource="https://edint.es/kos/CertificateType"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="es">Tipo de certificado de eficiencia energética según el vocabulario controlado de tipos de certificado: proyecto, obra terminada o edificio existente (Art. 2.b-g, Art. 9-10, Art. 15.2 RD 390/2021).</rdfs:comment>
        <rdfs:comment xml:lang="en">Type of energy performance certificate according to the certificate-type controlled vocabulary: project, completed work or existing building (Art. 2.b-g, Art. 9-10, Art. 15.2 RD 390/2021).</rdfs:comment>
        <rdfs:label xml:lang="en">certificate type</rdfs:label>
        <rdfs:label xml:lang="es">tipo de certificado</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://edint.es/def/certificado-energetico#co2Emissions -->


    <owl:ObjectProperty rdf:about="https://edint.es/def/certificado-energetico#co2Emissions">
        <rdfs:domain rdf:resource="https://edint.es/def/certificado-energetico#EnergyRating"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
        <rdfs:comment xml:lang="en">CO2 emissions. Expressed as qudt:QuantityValue, typically in kgCO2/m²·year.</rdfs:comment>
        <rdfs:comment xml:lang="es">Emisiones de CO2. Se expresa como qudt:QuantityValue, típicamente en kgCO2/m²·año.</rdfs:comment>
        <rdfs:label xml:lang="en">CO2 emissions</rdfs:label>
        <rdfs:label xml:lang="es">emisiones de CO2</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://edint.es/def/certificado-energetico#coolingConsumption -->


    <owl:ObjectProperty rdf:about="https://edint.es/def/certificado-energetico#coolingConsumption">
        <rdfs:domain rdf:resource="https://edint.es/def/certificado-energetico#EnergyRating"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
        <rdfs:comment xml:lang="es">Consumo de refrigeración. Se expresa como qudt:QuantityValue, típicamente en kWh/m²·año.</rdfs:comment>
        <rdfs:comment xml:lang="en">Cooling consumption. Expressed as qudt:QuantityValue, typically in kWh/m²·year.</rdfs:comment>
        <rdfs:label xml:lang="es">consumo de refrigeración</rdfs:label>
        <rdfs:label xml:lang="en">cooling consumption</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://edint.es/def/certificado-energetico#coolingDemand -->


    <owl:ObjectProperty rdf:about="https://edint.es/def/certificado-energetico#coolingDemand">
        <rdfs:domain rdf:resource="https://edint.es/def/certificado-energetico#EnergyRating"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
        <rdfs:comment xml:lang="en">Cooling demand. Expressed as qudt:QuantityValue, typically in kWh/m²·year.</rdfs:comment>
        <rdfs:comment xml:lang="es">Demanda de refrigeración. Se expresa como qudt:QuantityValue, típicamente en kWh/m²·año.</rdfs:comment>
        <rdfs:label xml:lang="en">cooling demand</rdfs:label>
        <rdfs:label xml:lang="es">demanda de refrigeración</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://edint.es/def/certificado-energetico#coolingEfficiency -->


    <owl:ObjectProperty rdf:about="https://edint.es/def/certificado-energetico#coolingEfficiency">
        <rdfs:domain rdf:resource="https://edint.es/def/certificado-energetico#EnergyCertificate"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
        <rdfs:comment xml:lang="es">Rendimiento estacional del sistema de refrigeración. Se expresa como qudt:QuantityValue.</rdfs:comment>
        <rdfs:comment xml:lang="en">Seasonal efficiency of the cooling system. Expressed as qudt:QuantityValue.</rdfs:comment>
        <rdfs:label xml:lang="es">rendimiento estacional refrigeración</rdfs:label>
        <rdfs:label xml:lang="en">seasonal cooling efficiency</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://edint.es/def/certificado-energetico#coolingEnergySource -->


    <owl:ObjectProperty rdf:about="https://edint.es/def/certificado-energetico#coolingEnergySource">
        <rdfs:domain rdf:resource="https://edint.es/def/certificado-energetico#EnergyCertificate"/>
        <rdfs:range>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#Concept"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
                        <owl:hasValue rdf:resource="https://edint.es/kos/EnergySource"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="en">Energy source of the cooling system according to the energy-source controlled vocabulary.</rdfs:comment>
        <rdfs:comment xml:lang="es">Fuente de energía del sistema de refrigeración según el vocabulario controlado de fuentes de energía.</rdfs:comment>
        <rdfs:label xml:lang="en">cooling energy source</rdfs:label>
        <rdfs:label xml:lang="es">fuente energética de refrigeración</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://edint.es/def/certificado-energetico#dataBasis -->


    <owl:ObjectProperty rdf:about="https://edint.es/def/certificado-energetico#dataBasis">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://edint.es/def/certificado-energetico#EnergyRating"/>
        <rdfs:range>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#Concept"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
                        <owl:hasValue rdf:resource="https://edint.es/kos/DataBasis"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="es">Indica si los indicadores se basan en datos medidos, calculados o mixtos, según el vocabulario controlado de tipos de base de datos (Art. 6.7).</rdfs:comment>
        <rdfs:comment xml:lang="en">Indicates whether indicators are based on measured, calculated or mixed data, according to the data-basis controlled vocabulary (Art. 6.7).</rdfs:comment>
        <rdfs:label xml:lang="es">base de datos</rdfs:label>
        <rdfs:label xml:lang="en">data basis</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://edint.es/def/certificado-energetico#dhwConsumption -->


    <owl:ObjectProperty rdf:about="https://edint.es/def/certificado-energetico#dhwConsumption">
        <rdfs:domain rdf:resource="https://edint.es/def/certificado-energetico#EnergyRating"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
        <rdfs:comment xml:lang="es">Consumo de agua caliente sanitaria. Se expresa como qudt:QuantityValue, típicamente en kWh/m²·año.</rdfs:comment>
        <rdfs:comment xml:lang="en">Domestic hot water consumption. Expressed as qudt:QuantityValue, typically in kWh/m²·year.</rdfs:comment>
        <rdfs:label xml:lang="en">DHW consumption</rdfs:label>
        <rdfs:label xml:lang="es">consumo de ACS</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://edint.es/def/certificado-energetico#dhwDemand -->


    <owl:ObjectProperty rdf:about="https://edint.es/def/certificado-energetico#dhwDemand">
        <rdfs:domain rdf:resource="https://edint.es/def/certificado-energetico#EnergyRating"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
        <rdfs:comment xml:lang="es">Demanda de agua caliente sanitaria. Se expresa como qudt:QuantityValue, típicamente en kWh/m²·año.</rdfs:comment>
        <rdfs:comment xml:lang="en">Domestic hot water demand. Expressed as qudt:QuantityValue, typically in kWh/m²·year.</rdfs:comment>
        <rdfs:label xml:lang="en">DHW demand</rdfs:label>
        <rdfs:label xml:lang="es">demanda de ACS</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://edint.es/def/certificado-energetico#dhwEnergySource -->


    <owl:ObjectProperty rdf:about="https://edint.es/def/certificado-energetico#dhwEnergySource">
        <rdfs:domain rdf:resource="https://edint.es/def/certificado-energetico#EnergyCertificate"/>
        <rdfs:range>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#Concept"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
                        <owl:hasValue rdf:resource="https://edint.es/kos/EnergySource"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="en">Energy source of the domestic hot water system according to the energy-source controlled vocabulary.</rdfs:comment>
        <rdfs:comment xml:lang="es">Fuente de energía del sistema de agua caliente sanitaria según el vocabulario controlado de fuentes de energía.</rdfs:comment>
        <rdfs:label xml:lang="en">DHW energy source</rdfs:label>
        <rdfs:label xml:lang="es">fuente energética de ACS</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://edint.es/def/certificado-energetico#envelopeArea -->


    <owl:ObjectProperty rdf:about="https://edint.es/def/certificado-energetico#envelopeArea">
        <rdfs:domain rdf:resource="https://edint.es/def/certificado-energetico#EnergyCertificate"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
        <rdfs:comment xml:lang="es">Superficie de la envolvente térmica en contacto con el exterior. Se expresa como qudt:QuantityValue (qudt:numericValue + qudt:hasUnit), típicamente en m².</rdfs:comment>
        <rdfs:comment xml:lang="en">Surface area of the thermal envelope in contact with the exterior. Expressed as qudt:QuantityValue (qudt:numericValue + qudt:hasUnit), typically in m².</rdfs:comment>
        <rdfs:label xml:lang="en">envelope area</rdfs:label>
        <rdfs:label xml:lang="es">superficie de envolvente</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://edint.es/def/certificado-energetico#estimatedCost -->


    <owl:ObjectProperty rdf:about="https://edint.es/def/certificado-energetico#estimatedCost">
        <rdfs:domain rdf:resource="https://edint.es/def/certificado-energetico#ImprovementRecommendation"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
        <rdfs:comment xml:lang="es">Coste estimado de la intervención. Se expresa como qudt:QuantityValue, típicamente en euros.</rdfs:comment>
        <rdfs:comment xml:lang="en">Estimated cost of the intervention. Expressed as qudt:QuantityValue, typically in euros.</rdfs:comment>
        <rdfs:label xml:lang="es">coste estimado</rdfs:label>
        <rdfs:label xml:lang="en">estimated cost</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://edint.es/def/certificado-energetico#estimatedSavingKwh -->


    <owl:ObjectProperty rdf:about="https://edint.es/def/certificado-energetico#estimatedSavingKwh">
        <rdfs:domain rdf:resource="https://edint.es/def/certificado-energetico#ImprovementRecommendation"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
        <rdfs:comment xml:lang="es">Ahorro estimado en energía. Se expresa como qudt:QuantityValue, típicamente en kWh/año.</rdfs:comment>
        <rdfs:comment xml:lang="en">Estimated energy saving. Expressed as qudt:QuantityValue, typically in kWh/year.</rdfs:comment>
        <rdfs:label xml:lang="es">ahorro estimado en energía</rdfs:label>
        <rdfs:label xml:lang="en">estimated saving in energy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://edint.es/def/certificado-energetico#estimatedSavingPct -->


    <owl:ObjectProperty rdf:about="https://edint.es/def/certificado-energetico#estimatedSavingPct">
        <rdfs:domain rdf:resource="https://edint.es/def/certificado-energetico#ImprovementRecommendation"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
        <rdfs:comment xml:lang="es">Ahorro estimado porcentual. Se expresa como qudt:QuantityValue, típicamente en porcentaje.</rdfs:comment>
        <rdfs:comment xml:lang="en">Estimated percentage saving. Expressed as qudt:QuantityValue, typically in percent.</rdfs:comment>
        <rdfs:label xml:lang="es">ahorro estimado</rdfs:label>
        <rdfs:label xml:lang="en">estimated saving</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://edint.es/def/certificado-energetico#globalHeatTransferCoeff -->


    <owl:ObjectProperty rdf:about="https://edint.es/def/certificado-energetico#globalHeatTransferCoeff">
        <rdfs:domain rdf:resource="https://edint.es/def/certificado-energetico#EnergyCertificate"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
        <rdfs:comment xml:lang="es">Coeficiente global de transmitancia térmica U de la envolvente. Se expresa como qudt:QuantityValue, típicamente en W/m²·K.</rdfs:comment>
        <rdfs:comment xml:lang="en">Global thermal transmittance coefficient U of the envelope. Expressed as qudt:QuantityValue, typically in W/m²·K.</rdfs:comment>
        <rdfs:label xml:lang="es">coeficiente global de transmitancia</rdfs:label>
        <rdfs:label xml:lang="en">global heat transfer coefficient</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://edint.es/def/certificado-energetico#hasLabel -->


    <owl:ObjectProperty rdf:about="https://edint.es/def/certificado-energetico#hasLabel">
        <owl:inverseOf rdf:resource="https://edint.es/def/certificado-energetico#labelFor"/>
        <rdfs:domain rdf:resource="https://edint.es/def/certificado-energetico#EnergyCertificate"/>
        <rdfs:range rdf:resource="https://edint.es/def/certificado-energetico#EnergyLabel"/>
        <rdfs:comment xml:lang="en">Energy label associated with the registered certificate.</rdfs:comment>
        <rdfs:comment xml:lang="es">Etiqueta de eficiencia energética asociada al certificado registrado.</rdfs:comment>
        <rdfs:label xml:lang="en">has label</rdfs:label>
        <rdfs:label xml:lang="es">tiene etiqueta</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://edint.es/def/certificado-energetico#hasObservedAddress -->


    <owl:ObjectProperty rdf:about="https://edint.es/def/certificado-energetico#hasObservedAddress">
        <rdfs:domain rdf:resource="https://edint.es/def/certificado-energetico#EnergyCertificate"/>
        <rdfs:range rdf:resource="http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/direccion-postal#DireccionPostal"/>
        <rdfs:comment xml:lang="es">Dirección postal del inmueble certificado. Se reutiliza esdir:DireccionPostal, que especializa schema:PostalAddress, vcard:Address y locn:Address, y permite representar vía, municipio, provincia y código postal con propiedades estándar (Art. 8.2.a).</rdfs:comment>
        <rdfs:comment xml:lang="en">Postal address of the certified property. Reuses esdir:DireccionPostal, which specialises schema:PostalAddress, vcard:Address and locn:Address, and allows representing street, municipality, province and postal code with standard properties (Art. 8.2.a).</rdfs:comment>
        <rdfs:label xml:lang="es">dirección del inmueble</rdfs:label>
        <rdfs:label xml:lang="en">observed address</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://edint.es/def/certificado-energetico#hasRating -->


    <owl:ObjectProperty rdf:about="https://edint.es/def/certificado-energetico#hasRating">
        <owl:inverseOf rdf:resource="https://edint.es/def/certificado-energetico#ratingOf"/>
        <rdfs:domain rdf:resource="https://edint.es/def/certificado-energetico#EnergyCertificate"/>
        <rdfs:range rdf:resource="https://edint.es/def/certificado-energetico#EnergyRating"/>
        <rdfs:comment xml:lang="en">Links a certificate to its energy rating indicators.</rdfs:comment>
        <rdfs:comment xml:lang="es">Vincula un certificado a sus indicadores de calificación energética.</rdfs:comment>
        <rdfs:label xml:lang="en">has rating</rdfs:label>
        <rdfs:label xml:lang="es">tiene calificación</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://edint.es/def/certificado-energetico#hasRecommendation -->


    <owl:ObjectProperty rdf:about="https://edint.es/def/certificado-energetico#hasRecommendation">
        <owl:inverseOf rdf:resource="https://edint.es/def/certificado-energetico#recommendationFor"/>
        <rdfs:domain rdf:resource="https://edint.es/def/certificado-energetico#EnergyCertificate"/>
        <rdfs:range rdf:resource="https://edint.es/def/certificado-energetico#ImprovementRecommendation"/>
        <rdfs:comment xml:lang="en">Improvement recommendation included in the certificate.</rdfs:comment>
        <rdfs:comment xml:lang="es">Recomendación de mejora incluida en el certificado.</rdfs:comment>
        <rdfs:label xml:lang="en">has recommendation</rdfs:label>
        <rdfs:label xml:lang="es">tiene recomendación</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://edint.es/def/certificado-energetico#hasTechnicianAddress -->


    <owl:ObjectProperty rdf:about="https://edint.es/def/certificado-energetico#hasTechnicianAddress">
        <rdfs:domain rdf:resource="https://edint.es/def/certificado-energetico#CompetentTechnician"/>
        <rdfs:range rdf:resource="http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/direccion-postal#DireccionPostal"/>
        <rdfs:comment xml:lang="es">Dirección postal del técnico competente. Se reutiliza esdir:DireccionPostal, que especializa schema:PostalAddress, vcard:Address y locn:Address, y permite representar vía, municipio, provincia y código postal con propiedades estándar (Anexo IV).</rdfs:comment>
        <rdfs:comment xml:lang="en">Postal address of the competent technician. Reuses esdir:DireccionPostal, which specialises schema:PostalAddress, vcard:Address and locn:Address, and allows representing street, municipality, province and postal code with standard properties (Annex IV).</rdfs:comment>
        <rdfs:label xml:lang="es">dirección del técnico</rdfs:label>
        <rdfs:label xml:lang="en">technician address</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://edint.es/def/certificado-energetico#hasUserRecommendations -->


    <owl:ObjectProperty rdf:about="https://edint.es/def/certificado-energetico#hasUserRecommendations">
        <rdfs:domain rdf:resource="https://edint.es/def/certificado-energetico#EnergyCertificate"/>
        <rdfs:range rdf:resource="https://edint.es/def/certificado-energetico#UserRecommendations"/>
        <rdfs:comment xml:lang="es">Documento de recomendaciones de uso entregado al usuario/arrendatario del edificio (Art. 8.1.f).</rdfs:comment>
        <rdfs:comment xml:lang="en">User recommendations document delivered to the building user/tenant (Art. 8.1.f).</rdfs:comment>
        <rdfs:label xml:lang="en">has user recommendations</rdfs:label>
        <rdfs:label xml:lang="es">tiene recomendaciones de uso</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://edint.es/def/certificado-energetico#heatingConsumption -->


    <owl:ObjectProperty rdf:about="https://edint.es/def/certificado-energetico#heatingConsumption">
        <rdfs:domain rdf:resource="https://edint.es/def/certificado-energetico#EnergyRating"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
        <rdfs:comment xml:lang="es">Consumo de calefacción. Se expresa como qudt:QuantityValue, típicamente en kWh/m²·año.</rdfs:comment>
        <rdfs:comment xml:lang="en">Heating consumption. Expressed as qudt:QuantityValue, typically in kWh/m²·year.</rdfs:comment>
        <rdfs:label xml:lang="es">consumo de calefacción</rdfs:label>
        <rdfs:label xml:lang="en">heating consumption</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://edint.es/def/certificado-energetico#heatingDemand -->


    <owl:ObjectProperty rdf:about="https://edint.es/def/certificado-energetico#heatingDemand">
        <rdfs:domain rdf:resource="https://edint.es/def/certificado-energetico#EnergyRating"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
        <rdfs:comment xml:lang="es">Demanda de calefacción. Se expresa como qudt:QuantityValue, típicamente en kWh/m²·año.</rdfs:comment>
        <rdfs:comment xml:lang="en">Heating demand. Expressed as qudt:QuantityValue, typically in kWh/m²·year.</rdfs:comment>
        <rdfs:label xml:lang="es">demanda de calefacción</rdfs:label>
        <rdfs:label xml:lang="en">heating demand</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://edint.es/def/certificado-energetico#heatingEfficiency -->


    <owl:ObjectProperty rdf:about="https://edint.es/def/certificado-energetico#heatingEfficiency">
        <rdfs:domain rdf:resource="https://edint.es/def/certificado-energetico#EnergyCertificate"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
        <rdfs:comment xml:lang="es">Rendimiento estacional del sistema de calefacción. Se expresa como qudt:QuantityValue.</rdfs:comment>
        <rdfs:comment xml:lang="en">Seasonal efficiency of the heating system. Expressed as qudt:QuantityValue.</rdfs:comment>
        <rdfs:label xml:lang="es">rendimiento estacional calefacción</rdfs:label>
        <rdfs:label xml:lang="en">seasonal heating efficiency</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://edint.es/def/certificado-energetico#heatingEnergySource -->


    <owl:ObjectProperty rdf:about="https://edint.es/def/certificado-energetico#heatingEnergySource">
        <rdfs:domain rdf:resource="https://edint.es/def/certificado-energetico#EnergyCertificate"/>
        <rdfs:range>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#Concept"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
                        <owl:hasValue rdf:resource="https://edint.es/kos/EnergySource"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="en">Energy source of the heating system according to the energy-source controlled vocabulary.</rdfs:comment>
        <rdfs:comment xml:lang="es">Fuente de energía del sistema de calefacción según el vocabulario controlado de fuentes de energía.</rdfs:comment>
        <rdfs:label xml:lang="es">fuente energética de calefacción</rdfs:label>
        <rdfs:label xml:lang="en">heating energy source</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://edint.es/def/certificado-energetico#improvedRatingLetter -->


    <owl:ObjectProperty rdf:about="https://edint.es/def/certificado-energetico#improvedRatingLetter">
        <rdfs:domain rdf:resource="https://edint.es/def/certificado-energetico#ImprovementRecommendation"/>
        <rdfs:range>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#Concept"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
                        <owl:hasValue rdf:resource="https://edint.es/kos/RatingLetter"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="en">Estimated energy rating letter after implementation of the recommendation, according to the rating-letter controlled vocabulary.</rdfs:comment>
        <rdfs:comment xml:lang="es">Letra de calificación energética estimada tras la implementación de la recomendación, según el vocabulario controlado de letras de calificación.</rdfs:comment>
        <rdfs:label xml:lang="es">calificación estimada tras mejora</rdfs:label>
        <rdfs:label xml:lang="en">improved rating letter</rdfs:label>
    </owl:ObjectProperty>
    


