    <owl:DatatypeProperty rdf:about="https://edint.es/def/certificado-energetico#visitDescription">
        <rdfs:domain rdf:resource="https://edint.es/def/certificado-energetico#EnergyCertificate"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Descripción de la visita in situ realizada (Art. 8.2.g).</rdfs:comment>
        <rdfs:comment xml:lang="en">Description of the on-site visit carried out (Art. 8.2.g).</rdfs:comment>
        <rdfs:label xml:lang="es">descripción de la visita</rdfs:label>
        <rdfs:label xml:lang="en">visit description</rdfs:label>
    </owl:DatatypeProperty>
    


