        <rdfs:domain rdf:resource="https://edint.es/def/certificado-energetico#EnergyCertificate"/>
        <rdfs:range rdf:resource="https://edint.es/def/certificado-energetico#CalculationProcedure"/>
        <rdfs:comment xml:lang="es">Procedimiento de cálculo reconocido utilizado para obtener la calificación.</rdfs:comment>
        <rdfs:comment xml:lang="en">Recognised calculation procedure used to obtain the rating.</rdfs:comment>
