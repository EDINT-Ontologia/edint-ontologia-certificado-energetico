        <rdfs:range rdf:resource="https://edint.es/def/certificado-energetico#CompetentTechnician"/>
        <rdfs:comment xml:lang="en">Competent technician who signs the certificate.</rdfs:comment>
        <rdfs:comment xml:lang="es">Técnico competente que suscribe el certificado.</rdfs:comment>
        <rdfs:label xml:lang="es">emitido por</rdfs:label>
        <rdfs:label xml:lang="en">issued by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://edint.es/def/certificado-energetico#issuedCertificate -->


    <owl:ObjectProperty rdf:about="https://edint.es/def/certificado-energetico#issuedCertificate">
        <rdfs:domain rdf:resource="https://edint.es/def/certificado-energetico#CompetentTechnician"/>
        <rdfs:range rdf:resource="https://edint.es/def/certificado-energetico#EnergyCertificate"/>
        <rdfs:comment xml:lang="es">Certificado emitido por este técnico.</rdfs:comment>
        <rdfs:comment xml:lang="en">Certificate issued by this technician.</rdfs:comment>
        <rdfs:label xml:lang="es">certificado emitido</rdfs:label>
        <rdfs:label xml:lang="en">issued certificate</rdfs:label>
    </owl:ObjectProperty>
    


