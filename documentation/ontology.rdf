        <rdfs:comment xml:lang="en">When comparing project→completed work certificates, the same version of the recognized document is used (Art. 9.4).</rdfs:comment>
        <rdfs:label xml:lang="es">usa misma versión del procedimiento</rdfs:label>
        <rdfs:label xml:lang="en">uses same procedure version</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://edint.es/def/certificado-energetico#validUntil -->


    <owl:DatatypeProperty rdf:about="https://edint.es/def/certificado-energetico#validUntil">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://edint.es/def/certificado-energetico#EnergyCertificate"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment xml:lang="en">Expiry date of the certificate, maximum 10 years from issue (Art. 13).</rdfs:comment>
        <rdfs:comment xml:lang="es">Fecha de caducidad del certificado, máximo 10 años desde la emisión (Art. 13).</rdfs:comment>
        <rdfs:label xml:lang="en">valid until</rdfs:label>
        <rdfs:label xml:lang="es">válido hasta</rdfs:label>
    </owl:DatatypeProperty>
    


