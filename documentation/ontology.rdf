        <rdfs:comment xml:lang="en">Lighting consumption. Expressed as qudt:QuantityValue, typically in kWh/m²·year.</rdfs:comment>
        <rdfs:label xml:lang="es">consumo de iluminación</rdfs:label>
        <rdfs:label xml:lang="en">lighting consumption</rdfs:label>
    </owl:ObjectProperty>
    


