    <owl:ObjectProperty rdf:about="https://edint.es/def/certificado-energetico#labelFor">
        <rdfs:domain rdf:resource="https://edint.es/def/certificado-energetico#EnergyLabel"/>
        <rdfs:range rdf:resource="https://edint.es/def/certificado-energetico#EnergyCertificate"/>
        <rdfs:comment xml:lang="es">Certificado al que corresponde esta etiqueta.</rdfs:comment>
        <rdfs:comment xml:lang="en">Certificate this label belongs to.</rdfs:comment>
        <rdfs:label xml:lang="es">etiqueta para</rdfs:label>
        <rdfs:label xml:lang="en">label for</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://edint.es/def/certificado-energetico#labelRatingLetter -->


    <owl:ObjectProperty rdf:about="https://edint.es/def/certificado-energetico#labelRatingLetter">
        <rdfs:domain rdf:resource="https://edint.es/def/certificado-energetico#EnergyLabel"/>
        <rdfs:range>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#Concept"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
                        <owl:hasValue rdf:resource="https://edint.es/kos/RatingLetter"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="es">Letra de calificación mostrada en la etiqueta, según el vocabulario controlado de letras de calificación (Art. 15).</rdfs:comment>
        <rdfs:comment xml:lang="en">Rating letter shown on the label, according to the rating-letter controlled vocabulary (Art. 15).</rdfs:comment>
        <rdfs:label xml:lang="en">label rating letter</rdfs:label>
        <rdfs:label xml:lang="es">letra de la etiqueta</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://edint.es/def/certificado-energetico#lightingConsumption -->


    <owl:ObjectProperty rdf:about="https://edint.es/def/certificado-energetico#lightingConsumption">
        <rdfs:domain rdf:resource="https://edint.es/def/certificado-energetico#EnergyRating"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
