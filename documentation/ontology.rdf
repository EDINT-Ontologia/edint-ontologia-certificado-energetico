        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
        <rdfs:comment xml:lang="en">Percentage of glazing/openings relative to facade area. Expressed as qudt:QuantityValue, typically in percent.</rdfs:comment>
        <rdfs:comment xml:lang="es">Porcentaje de huecos/acristalamiento sobre fachada. Se expresa como qudt:QuantityValue, típicamente en porcentaje.</rdfs:comment>
        <rdfs:label xml:lang="es">ratio huecos/fachada</rdfs:label>
        <rdfs:label xml:lang="en">window-to-wall ratio</rdfs:label>
    </owl:ObjectProperty>
    


