    <owl:DatatypeProperty rdf:about="https://edint.es/def/certificado-energetico#visitDate">
        <rdfs:domain rdf:resource="https://edint.es/def/certificado-energetico#EnergyCertificate"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment xml:lang="en">Date of the on-site visit to the building (Art. 6.5, Art. 8.2.g).</rdfs:comment>
        <rdfs:comment xml:lang="es">Fecha de la visita in situ al edificio (Art. 6.5, Art. 8.2.g).</rdfs:comment>
        <rdfs:label xml:lang="es">fecha de visita</rdfs:label>
        <rdfs:label xml:lang="en">visit date</rdfs:label>
    </owl:DatatypeProperty>
    


