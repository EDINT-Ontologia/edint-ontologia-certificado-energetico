        <rdfs:comment xml:lang="en">Measured cooling consumption. Expressed as qudt:QuantityValue, typically in kWh/m²·year.</rdfs:comment>
        <rdfs:label xml:lang="es">consumo medido de refrigeración</rdfs:label>
        <rdfs:label xml:lang="en">measured cooling consumption</rdfs:label>
